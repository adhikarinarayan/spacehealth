{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacehealth.local/contracts/daily-reading.schema.json",
  "type": "object",
  "properties": {
    "crewId": {
      "enum": [
        "C1",
        "C2",
        "C3",
        "C4"
      ]
    },
    "missionDay": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -14,
          "maximum": -1,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 180,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        }
      ]
    },
    "rhr_bpm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "hrv_rmssd_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "skin_temp_delta_c": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sleep_hours": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "symptoms": {
      "type": "array",
      "items": {
        "enum": [
          "fever",
          "sore_throat",
          "cough",
          "congestion",
          "fatigue",
          "headache",
          "muscle_ache",
          "shortness_of_breath",
          "chest_pain",
          "fainting",
          "vision_change",
          "nausea",
          "rash",
          "other"
        ]
      }
    },
    "daily_dose_msv": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "mood_1to5": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "stress_1to5": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "pvt_mean_rt_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pvt_lapses": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "checkin_completed": {
      "type": "boolean"
    },
    "dose_coverage": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "not": {
            "exclusiveMinimum": 1.7976931348623157e+308
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "rhr_bpm": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "hrv_rmssd_ms": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "skin_temp_delta_c": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "sleep_hours": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "symptoms": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "spe_warning": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "dose_rate_msv_h": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "daily_dose_msv": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "prior_career_dose_msv": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "pvt_mean_rt_ms": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "pvt_lapses": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "mood_1to5": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "stress_1to5": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "exercise_minutes": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        },
        "co2_ppm": {
          "enum": [
            "sensor",
            "manual",
            "synthetic",
            "calculated"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "crewId",
    "missionDay",
    "rhr_bpm",
    "hrv_rmssd_ms",
    "skin_temp_delta_c",
    "sleep_hours",
    "symptoms",
    "daily_dose_msv",
    "checkin_completed",
    "dose_coverage",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "checkin_completed": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "symptoms": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
