{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacehealth.local/contracts/validation.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "simulated": {
      "const": true
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seedSet": {
      "enum": [
        "dev",
        "holdout"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4",
              "N1",
              "N2"
            ]
          },
          "crewId": {
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4"
            ]
          },
          "moduleId": {
            "anyOf": [
              {
                "enum": [
                  "sleep_alertness",
                  "physiological_change",
                  "radiation"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "passRule": {
            "type": "string",
            "minLength": 1
          },
          "onsetDay": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 180,
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "symptomDay": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 180,
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "firstWatchDay": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 180,
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "firstActDay": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 180,
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "delayVsOnsetDays": {
            "anyOf": [
              {
                "type": "integer",
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "delayVsSymptomDays": {
            "anyOf": [
              {
                "type": "integer",
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "routineFalseAlerts": {
            "type": "integer",
            "minimum": 0,
            "not": {
              "exclusiveMinimum": 1.7976931348623157e+308
            }
          },
          "evaluableCrewDays": {
            "type": "integer",
            "minimum": 0,
            "not": {
              "exclusiveMinimum": 1.7976931348623157e+308
            }
          },
          "falseAlertsPer100CrewDays": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "not": {
                  "exclusiveMinimum": 1.7976931348623157e+308
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "unknownDays": {
            "type": "integer",
            "minimum": 0,
            "not": {
              "exclusiveMinimum": 1.7976931348623157e+308
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "scenarioId",
          "crewId",
          "moduleId",
          "passed",
          "passRule",
          "onsetDay",
          "symptomDay",
          "firstWatchDay",
          "firstActDay",
          "delayVsOnsetDays",
          "delayVsSymptomDays",
          "routineFalseAlerts",
          "evaluableCrewDays",
          "falseAlertsPer100CrewDays",
          "unknownDays",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "simulated",
    "modelId",
    "configHash",
    "seedSet",
    "results"
  ],
  "additionalProperties": false
}
